{
  "name": "fluently-english",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A free, browser-based English learning and practice platform.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "curriculum": "node scripts/compile-curriculum.mjs",
    "build": "node scripts/build.mjs",
